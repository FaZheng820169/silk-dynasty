# ============================================================
# Silk Dynasty 锦衣 — environment template
# Copy to .env and fill in. The site runs without any of these
# (free preview + concierge email mode); the auto try-on and
# checkout need the keys below.
# ============================================================

# --- AI generation provider ---
# Set to: kontext | seedream | qwen-edit | mock
# kontext is the default: FLUX.1 Kontext dev on a public Hugging Face Space —
# instruction-based editing that keeps the customer's actual face, no key
# required. Verified to work; see KONTEXT_HF_TOKEN below for reliability.
GEN_PROVIDER=kontext

# The Kontext Space the renderer calls. Swap in your own copy of the Space
# (duplicate it on Hugging Face, attach a GPU) to get a private queue.
KONTEXT_SPACE=https://black-forest-labs-flux-1-kontext-dev.hf.space

# Strongly recommended. The public Space shares a small anonymous GPU quota
# which runs out after ~3 renders, after which Automatic mode degrades to the
# Concierge email flow. A Hugging Face token with Pro attached puts this
# account in the priority GPU queue and makes Automatic dependable.
# https://huggingface.co/settings/tokens
KONTEXT_HF_TOKEN=

# ByteDance ARK (Seedream 5.0 supports multiple reference images —
# the person photo + a dynasty garment reference). Best identity fidelity
# if you would rather buy throughput than lean on a shared Space.
# https://console.volcengine.com/ark
ARK_API_KEY=
ARK_ENDPOINT_ID=

# Alibaba DashScope (qwen-image-edit — instruction-based image edit).
# https://dashscope.console.aliyun.com/
DASHSCOPE_API_KEY=

# --- Dynasty garment reference images (public URLs) ---
# Required for the seedream provider so the model knows the cut of
# each robe. Host the files in assets/img/ somewhere public.
GARMENT_REF_TANG=
GARMENT_REF_SONG=
GARMENT_REF_MING=

# --- Checkout (Paddle) ---
# Use Paddle Payment Links (one URL per plan) — no vendor JS needed.
# Create links at https://vendors.paddle.com/
PAY_LINK_SINGLE=
PAY_LINK_TRIO=
PAY_LINK_HEIRLOOM=

# --- Delivery mailbox (concierge orders) ---
ATELIER_EMAIL=hello@silkdynasty.studio
