# ============================================================
# Silk Dynasty 锦衣 — environment template
# Copy to .env and fill in. The site runs without any of these
# (free preview + concierge email mode); the auto try-on and
# checkout need the keys below.
# ============================================================

# --- AI generation provider ---
# Set to: kontext | seedream | qwen-edit | mock
# kontext is the default: a pool of Hugging Face Spaces (FLUX.1 Kontext dev,
# then Qwen-Image-Edit, then Qwen-Image-Edit Fast) that take one photograph and
# dress it in the chosen dynasty while keeping the customer's actual face.
# Verified to work; see KONTEXT_HF_TOKEN below — it is what makes it dependable.
GEN_PROVIDER=kontext

# The Kontext Space the pool starts with. Swap in your own copy of the Space
# (duplicate it on Hugging Face, attach a GPU) to get a private queue.
KONTEXT_SPACE=https://black-forest-labs-flux-1-kontext-dev.hf.space
# Optional: override the second renderer in the pool.
QWEN_EDIT_SPACE=https://qwen-qwen-image-edit.hf.space

# Required for a dependable Automatic mode. Every public Space shares one
# anonymous GPU quota; without a token the pool runs dry and Automatic degrades
# to the Concierge email flow. A free Hugging Face account token puts you in the
# signed-in queue (Pro raises the daily allowance further).
# https://huggingface.co/settings/tokens  — read-only token is enough.
KONTEXT_HF_TOKEN=
# HF_TOKEN is accepted as an alias, so the standard variable also works.

# ByteDance ARK (Seedream 5.0 supports multiple reference images —
# the person photo + a dynasty garment reference). Best identity fidelity
# if you would rather buy throughput than lean on a shared Space.
# https://console.volcengine.com/ark
ARK_API_KEY=
ARK_ENDPOINT_ID=

# Alibaba DashScope (qwen-image-edit — instruction-based image edit).
# https://dashscope.console.aliyun.com/
DASHSCOPE_API_KEY=

# --- Dynasty garment reference images (public URLs) ---
# Required for the seedream provider so the model knows the cut of
# each robe. Host the files in assets/img/ somewhere public.
GARMENT_REF_TANG=
GARMENT_REF_SONG=
GARMENT_REF_MING=

# --- Checkout (Paddle) ---
# Use Paddle Payment Links (one URL per plan) — no vendor JS needed.
# Create links at https://vendors.paddle.com/
PAY_LINK_SINGLE=
PAY_LINK_TRIO=
PAY_LINK_HEIRLOOM=

# The concierge order mailbox lives in assets/js/site-config.js (atelierEmail),
# since the browser builds the mailto draft — the server never sees it.
